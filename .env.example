# KIS API credentials
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_HTS_ID=your_hts_id

# Live trading safety (default OFF)
KIS_LIVE_ENABLED=0
KIS_LIVE_CONFIRM=

# Emergency stop
KIS_KILL_SWITCH=0

# HARD SAFETY: disallow dummy token/approval_key in live mode
# Only set to 1 temporarily for debugging in dev mode.
KIS_ALLOW_DUMMY_CREDENTIALS=0

# Personal risk caps (recommended conservative defaults)
KIS_MAX_POSITION_QTY=50
KIS_MAX_TRADES_PER_DAY=3

# Health/status
KIS_HEALTHCHECK_INTERVAL_SEC=60

# Event logging
# Recommended: keep tick logging OFF (bars/orders/fills are enough for replay)
KIS_EVENT_LOG_TICKS=0

# Institutional feature flags (recommended default OFF)
KIS_INSTITUTIONAL_OMS=0
KIS_INSTITUTIONAL_LEDGER=0
KIS_INSTITUTIONAL_RECONCILE=0

# Token/approval rate-limit protection
KIS_TOKEN_MIN_INTERVAL_SEC=62
KIS_APPROVAL_MIN_INTERVAL_SEC=62

# Token cache location (recommended: keep under logs/)
KIS_TOKEN_CACHE_PATH=logs/kis_token_cache.json

# Market-closed log throttle
KIS_MARKET_CLOSED_LOG_INTERVAL_SEC=1200
