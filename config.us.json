{
  "env": "local",
  "timezone": "Asia/Seoul",
  "account": {
    "account_no": "YOUR_ACCOUNT_NO",
    "account_product_code": "01"
  },
  "rest": {
    "base_url": "https://openapi.koreainvestment.com:9443",
    "mock": false
  },
  "logging": {
    "dir": "logs"
  },
  "trading": {
    "entry_budget_pct": 0.12,
    "max_entries_per_day": 10,
    "max_concurrent_positions": 20,
    "entry_retry_limit": 3,
    "max_total_position_pct": 0.6,
    "max_symbol_position_pct": 0.08,
    "cash_reserve_pct": 0.2,
    "max_new_entries_per_minute": 2,
    "max_spread_pct": 0.01,
    "scoring": {
      "us_swing_entry_threshold": 68,
      "us_scalp_entry_threshold": 75
    },
    "use_orb_confirmation": false,
    "allow_orb_retest_confirmation": true,
    "orb_volume_power_threshold": 110.0,
    "orb_retest_tolerance_pct": 0.002,
    "use_indicator_gate_mode": false,
    "strict_data_safety_mode": false,
    "news_safety_mode": true,
    "enable_dynamic_ml_threshold": true,
    "microstructure_filter": {
      "enabled": true,
      "max_spread_pct": 0.006,
      "max_book_age_sec": 6.0,
      "min_quote_depth_ratio": 0.4
    },
    "slippage_guard": {
      "enabled": true,
      "rolling_window": 20,
      "min_samples_before_block": 3,
      "max_avg_slippage_bps": 80.0,
      "max_worst_slippage_bps": 180.0,
      "block_seconds": 600
    },
    "execution": {
      "enable_smart_limit_exit": true,
      "entry_poll_sec": 1.0,
      "entry_max_cancel_attempts": 1,
      "cancel_unfilled_entry": true,
      "exit_retry_limit": 2,
      "exit_poll_sec": 1.0,
      "exit_max_cancel_attempts": 1
    }
  },
  "us_trading": {
    "enabled": true,
    "timezone": "America/New_York",
    "market_open": "09:30:00",
    "market_close": "16:00:00",
    "early_exit": "15:30:00",
    "force_exit": "15:45:00",
    "same_day_trading": true
  },
  "automation": {
    "retry": {
      "max_attempts": 5,
      "base_delay_sec": 1,
      "max_delay_sec": 60,
      "jitter": true,
      "rate_limit_cooldown_sec": 65
    },
    "healthcheck": {
      "enabled": true,
      "interval_sec": 60
    }
  },
  "modules": {
    "kukjang": {
      "enabled": false
    },
    "kr_swing": {
      "enabled": false
    },
    "hwanjeon": {
      "enabled": false
    },
    "us_swing": {
      "enabled": false,
      "symbols": [
        "AAPL",
        "MSFT",
        "NVDA",
        "TSLA",
        "SCHD"
      ],
      "exchange": "NASD",
      "bar_minutes": 15,
      "entry_budget_pct": 0.12,
      "stop_loss_pct": -0.03,
      "take_profit_pct": 0.06,
      "entry_retry_limit": 3,
      "dynamic_universe": {
        "enabled": true,
        "scan_interval_sec": 600,
        "top_n": 120,
        "max_symbols": 60,
        "min_price_usd": 3,
        "min_liquidity": 500000,
        "volatility_preference": "stable_trend",
        "exchanges": [
          "NASD",
          "NYSE",
          "AMEX"
        ]
      }
    },
    "mijang": {
      "enabled": false,
      "symbols": [],
      "exchange": "NASD",
      "stop_loss_pct": -0.03,
      "take_profit_pct": 0.05,
      "force_exit": "04:00:00",
      "dynamic_universe": {
        "enabled": true,
        "scan_interval_sec": 300,
        "source": "popular_list",
        "top_n": 60,
        "max_symbols": 30,
        "min_price_usd": 5,
        "min_liquidity": 1000000,
        "volatility_preference": "high",
        "exchanges": [
          "NASD",
          "NYSE",
          "AMEX"
        ]
      }
    }
  }
}
